# Zynapse environment template.
# Copy this file to `.env` and fill only the providers you want to use.

# AI providers
GEMINI_API_KEY=
GROQ_API_KEY=
CLAUDE_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=
NVIDIA_API_KEY=

# Local Ollama provider
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Compiler / execution providers
PISTON_URL=https://emkc.org/api/v2/piston
JDOODLE_CLIENT_ID=
JDOODLE_CLIENT_SECRET=
ZYNAPSE_LOCAL_EXECUTOR=true
ZYNAPSE_LOCAL_EXEC_TIMEOUT_MS=8000
ZYNAPSE_LOCAL_EXEC_MAX_BYTES=120000

# App server
PORT=3000
APP_URL=http://localhost:3000
